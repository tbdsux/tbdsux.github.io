---
import Layout from "./Layout.astro";

type Props = {
  title: string;
};

const props = Astro.props;
---

<Layout title={`${props.title} | Joshue Abance`}>
  <article>
    <h1 class="text-2xl font-semibold text-neutral-100">{props.title}</h1>

    <div class="prose prose-neutral dark:prose-invert mt-12 max-w-none prose-headings:font-semibold prose-h1:text-xl prose-h2:text-lg prose-h3:text-base prose-a:decoration-neutral-600 prose-a:underline-offset-4 prose-code:before:content-none prose-code:after:content-none">
      <slot />
    </div>
  </article>
</Layout>
