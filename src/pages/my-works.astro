---
import type { Portfolio } from "../types/works";

import Works from "../components/Works.astro";
import Layout from "../layouts/Layout.astro";

const works = (await fetch(
  new URL("/api/portfolio/projects", import.meta.env.PORTFOLIO_ADMIN_API_URL)
)
  .then((res) => res.json())
  .catch(() => [])) as Portfolio[];
---

<Layout title="My Works | Joshue Abance">
  <h1 class="text-2xl font-semibold text-neutral-100">Works</h1>
  <p class="mt-2 text-sm text-neutral-500">
    Some of the projects I've built. More on
    <a
      href="https://github.com/tbdsux?tab=repositories"
      target="_blank"
      rel="noreferrer"
      class="text-neutral-300 underline decoration-neutral-700 underline-offset-4 hover:decoration-neutral-300"
    >
      GitHub</a
    > and
    <a
      href="https://git.tbdh.app/"
      target="_blank"
      rel="noreferrer"
      class="text-neutral-300 underline decoration-neutral-700 underline-offset-4 hover:decoration-neutral-300"
    >
      git.tbdh.app</a
    >.
  </p>

  <div class="mt-12 space-y-12">
    {
      works.map((item) => (
        <section>
          <h2 class="text-xs uppercase tracking-widest text-neutral-500">
            {item.name}
          </h2>
          <Works works={item.projects} />
        </section>
      ))
    }
  </div>
</Layout>
