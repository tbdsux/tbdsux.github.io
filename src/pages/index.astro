---
import Layout from "../layouts/Layout.astro";

const links = [
  { label: "github", handle: "@tbdsux", href: "https://github.com/tbdsux/" },
  { label: "git", handle: "git.tbdh.app", href: "https://git.tbdh.app/" },
  { label: "x", handle: "@_jlazz_", href: "https://twitter.com/_jlazz_" },
  {
    label: "discord",
    handle: "joshue?#9999",
    href: "https://discordapp.com/users/475085200414605334",
  },
];
---

<Layout title="Joshue Abance - Personal Website">
  <section>
    <div class="flex items-center gap-5">
      <img
        src="https://avatars.githubusercontent.com/u/37932956?v=4&s=128"
        alt="Joshue Abance's GitHub avatar"
        width="64"
        height="64"
        class="size-16 rounded-full border border-neutral-800"
      />
      <div>
        <h1 class="text-2xl font-semibold text-neutral-100">Joshue Abance</h1>
        <p class="mt-1 text-sm text-neutral-500">@tbdsux · developer</p>
      </div>
    </div>

    <div class="mt-8 space-y-4 leading-relaxed">
      <p>
        I love creating real-world projects and applications, mainly web apps,
        using the popular frameworks available.
      </p>
      <p>
        I enjoy experimenting with multiple programming languages and
        frameworks. Happy coding!
      </p>
    </div>
  </section>

  <section class="mt-14">
    <h2 class="mb-4 text-xs uppercase tracking-widest text-neutral-500">
      Elsewhere
    </h2>
    <ul class="space-y-2 text-sm">
      {
        links.map((l) => (
          <li class="flex gap-4">
            <span class="w-20 shrink-0 text-neutral-500">{l.label}</span>
            <a
              href={l.href}
              target="_blank"
              rel="noreferrer"
              class="text-neutral-200 underline decoration-neutral-700 underline-offset-4 hover:decoration-neutral-300"
            >
              {l.handle}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14">
    <a
      href="/my-works"
      class="text-sm text-neutral-200 underline decoration-neutral-700 underline-offset-4 hover:decoration-neutral-300"
    >
      See what I've built →
    </a>
  </section>
</Layout>
